# ---- Environment mode --------------------------------------------------
# Explicit preview mode for Arena — uses SQLite fallback when postgres unavailable
# Production must use PostgreSQL + Redis + persistent SESSION_SECRET
# Preview: local fallback DB + in-memory cache where necessary
# Production: PostgreSQL + Redis
APP_ENV=preview
USE_LOCAL_DEV_DB=true

# ---- PostgreSQL (production, required in prod non-preview) -------------
# In production non-preview, DATABASE_URL is required or app fails fast
# In preview/development, if DATABASE_URL missing, SQLite fallback is used
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Sessions (required in production/preview) -------------------------
# HMAC key that signs anonymous session cookies. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT for preview/production deployments:
# Do NOT rely on manually editing .env — some platforms re-provision .env and may remove SESSION_SECRET. Instead:
#   1. Open the platform's environment variables / secrets configuration.
#   2. Add SESSION_SECRET=<long-random-secret> (≥16 chars, 32-byte hex recommended).
#   3. Redeploy/restart the application.
#   4. Verify GET /api/session reuses the same session on refresh.
#
# Local development:
#   If unset, an ephemeral per-process secret is used (sessions reset on restart).
#   Production/preview MUST have SESSION_SECRET set or the app will fail fast.
SESSION_SECRET=replace-with-a-long-random-secret

# ---- Session cookie mode (explicit, do NOT infer from proxy headers) ----
# The preview proxy strips sec-fetch-site and x-forwarded-proto, so cookie
# attributes must be configured explicitly via env vars, not headers.
#
# For local HTTP development (http://localhost:3000):
#   SESSION_COOKIE_SECURE=false
#   SESSION_COOKIE_SAMESITE=lax
#   SESSION_COOKIE_PARTITIONED=false
#
# For HTTPS preview/production (embedded cross-site iframe, e.g. *.e2b.app):
#   SESSION_COOKIE_SECURE=true
#   SESSION_COOKIE_SAMESITE=none
#   SESSION_COOKIE_PARTITIONED=true
#
# Defaults:
#   NODE_ENV=production → Secure=true, SameSite=None, Partitioned=true
#   NODE_ENV=development → Secure=false, SameSite=Lax, Partitioned=false
# You can override explicitly with the variables below.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PARTITIONED=false

# For preview/production deployments, set in platform env vars:
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_PARTITIONED=true

# ---- Public origin (optional) ------------------------------------------
# Canonical URL of the deployment (used for diagnostics/docs).
APP_URL=http://localhost:3000

# ---- Redis (optional) ---------------------------------------------------
# Production: set REDIS_URL for Redis cache (else in-memory)
# Preview: if REDIS_URL unavailable, in-memory fallback is used automatically
# REDIS_URL=redis://127.0.0.1:6379

# ---- SQLite fallback (preview only) ------------------------------------
# File-backed SQLite for Arena preview when postgres unavailable
# Ignored in production unless APP_ENV=preview or USE_LOCAL_DEV_DB=true
SQLITE_DB_PATH=./data/tandem.db

# ---- Code execution sandbox -------------------------------------------
# Production should use a dedicated Linux Docker image containing gcc, g++,
# python3, node, bash, and the TypeScript runtime dependencies required by the
# app. If no safe backend is configured, /execute returns status "unavailable"
# and never falls back to unsafe host execution.
# TANDEM_EXECUTION_BACKEND=docker
# TANDEM_EXECUTION_IMAGE=your-tandem-executor-image:tag

# Local Linux/preview development may use the namespace sandbox. This creates
# user/pid/mount/network namespaces, strips env secrets, masks the repo path,
# applies limits, and cleans the temp workspace. It is not a replacement for a
# hardened production container sandbox.
# TANDEM_EXECUTION_BACKEND=linux-namespace
# TANDEM_ENABLE_LINUX_NAMESPACE_EXECUTOR=true
