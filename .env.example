# ---- PostgreSQL (required) ---------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Sessions (required in production) ---------------------------------
# HMAC key that signs anonymous session cookies. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a per-process ephemeral secret is used (sessions reset on restart).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Public origin (optional) ------------------------------------------
# Canonical URL of the deployment (used for diagnostics/docs).
APP_URL=http://localhost:3000

# ---- Redis (optional) ---------------------------------------------------
# When set, active room buffers check-point through Redis during editing.
# Unset → the same code runs on the in-memory cache transparently.
# REDIS_URL=redis://127.0.0.1:6379
