# Tandem environment variables
# Never commit real secrets. Configure production values in Vercel Project Settings.

# ---------------------------------------------------------------------
# PRODUCTION (Vercel Production) — required
# ---------------------------------------------------------------------
# Explicitly marks a real production deployment. When APP_ENV=production or
# VERCEL_ENV=production, Tandem refuses SQLite/localhost database fallbacks and
# requires Redis for shared realtime state.
APP_ENV=production

# Managed PostgreSQL connection string. Do not use localhost/127.0.0.1 in Vercel.
# Example providers: Vercel Postgres/Neon/Supabase/Railway/Render PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long random HMAC secret for signed HttpOnly sessions and bearer fallback tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Recommended for the top-level first-party Vercel production site.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PARTITIONED=false

# ---------------------------------------------------------------------
# PRODUCTION (Vercel Production) — required for realtime collaboration
# ---------------------------------------------------------------------
# Managed Redis/Valkey URL. Required in production because Vercel serverless
# instances do not share memory; Tandem uses Redis for hot document state,
# operation ordering locks, pub/sub fan-out, presence, and shared rate limits.
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# ---------------------------------------------------------------------
# PRODUCTION — optional
# ---------------------------------------------------------------------
# Canonical app URL used only for diagnostics/docs. Do not use localhost in prod.
APP_URL=https://your-tandem-app.vercel.app

# Code execution is disabled safely unless an isolated backend is configured.
# Local Docker settings do not work on Vercel's Next.js runtime. Production can
# use a private Piston-compatible isolated executor service; do not execute user
# code on the app host.
TANDEM_EXECUTION_BACKEND=disabled
# TANDEM_EXECUTION_BACKEND=piston
# TANDEM_PISTON_API_URL=https://your-private-piston-service.example.com
# TANDEM_EXECUTION_TIMEOUT_MS=600000

# ---------------------------------------------------------------------
# PREVIEW / STAGING
# ---------------------------------------------------------------------
# For Vercel Preview deployments that should behave like production, prefer:
# APP_ENV=preview
# DATABASE_URL=<managed preview PostgreSQL>
# REDIS_URL=<managed preview Redis>
# SESSION_SECRET=<long random secret>
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_PARTITIONED=false
#
# For an actual embedded/cross-site preview iframe, override to:
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_PARTITIONED=true
#
# SQLite fallback is allowed only for explicit local/ephemeral preview testing.
# It is not durable on serverless platforms.
# APP_ENV=preview
# USE_LOCAL_DEV_DB=true
# SQLITE_DB_PATH=./data/tandem.db

# ---------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------
# Local SQLite fallback. Do not set USE_LOCAL_DEV_DB=true in Vercel Production.
# APP_ENV=development
# USE_LOCAL_DEV_DB=true
# SQLITE_DB_PATH=./data/tandem.db
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_PARTITIONED=false
# APP_URL=http://localhost:3000

# Local Docker execution (preserved):
# docker build -f docker/executor.Dockerfile -t tandem-executor:local .
# TANDEM_EXECUTION_BACKEND=docker
# TANDEM_EXECUTION_IMAGE=tandem-executor:local
